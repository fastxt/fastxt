{
  "canisters": {
    "fastxt_ic": {
      "main": "src/fastxt_ic/main.mo",
      "type": "motoko"
    },
    "fastxt_ic_assets": {
      "dependencies": [
        "fastxt_ic"
      ],
      "frontend": {
        "entrypoint": "src/fastxt_ic_assets/public/index.js"
      },
      "source": [
        "src/fastxt_ic_assets/assets",
        "dist/fastxt_ic_assets/"
      ],
      "type": "assets"
    }
  },
  "defaults": {
    "build": {
      "packtool": ""
    }
  },
  "dfx": "0.6.16",
  "networks": {
    "ic": {
      "providers": [
        "https://gw.dfinity.network"
      ],
      "type": "persistent"
    },
    "local": {
      "bind": "127.0.0.1:8000",
      "type": "ephemeral"
    }
  },
  "version": 1
}