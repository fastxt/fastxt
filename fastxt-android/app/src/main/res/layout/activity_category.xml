<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/category_list_container"
        android:layout_marginTop="16dp"
        style="@style/Widget.RecyclerView"
            android:id="@+id/category_list"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/organizeStatus"
            style="@style/Widget.TextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/organize_status"
            android:visibility="gone" />

        <Button
            android:id="@+id/organizeButton"
            style="@style/Widget.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/organize"
            android:onClick="v -> organizeNotes()" />

        <TextView
            android:id="@+id/categoryEmpty"
            style="@style/Widget.TextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/category_empty"
            android:visibility="gone" />

    </android.support.v4.widget.RecyclerView>

</manifest>